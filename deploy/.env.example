# Quokka – the settings of deploy/docker-compose.yml. Copy to .env (or paste into Portainer's stack variables) and
# fill in. Never commit the real file: it holds QUOKKA_SECRET and the Pocket ID client secret.

# --- required ---
# where push-images put the images (quokka and quokka-sorter)
QUOKKA_REGISTRY=registry.example.com
# the domain(s) of the family's addresses, space separated
MAIL_DOMAINS=example.it
# your mail provider's servers (IMAP to read, SMTP to send)
IMAP_HOST=imap.example.com
SMTP_HOST=smtp.example.com
# your time zone
TZ=Europe/Berlin
# Quokka's address, as people open it
QUOKKA_PUBLIC_URL=https://mail.example.it
# openssl rand -hex 32   (keep a copy in your password manager: without it the encrypted data can't be read)
QUOKKA_SECRET=
# folders on the server
QUOKKA_DATA=/srv/quokka/data
SORTER_DATA=/srv/quokka/sorter
# optional: mailboxes nobody opens in Quokka (README.md, "The sorter's mailboxes")
# SORTER_ACCOUNTS=/srv/quokka/accounts.json

# --- Pocket ID (optional) ---
# the client in Pocket ID: callback https://mail.example.it/?QuokkaSsoCallback
QUOKKA_OIDC_ISSUER=https://id.example.it
QUOKKA_OIDC_CLIENT_ID=
QUOKKA_OIDC_CLIENT_SECRET=

# --- the family apps (optional) ---
# the address Quokka's server uses to reach them (the public one, or http://pelican:8000 on a shared Docker network)
QUOKKA_PELICAN_URL=
QUOKKA_KOOKA_URL=

# --- usually left as they are ---
# QUOKKA_TAG=latest             a fixed version: the commit, e.g. 3a4568e (push-images.sh tags both)
# IMAP_PORT=993
# IMAP_SECURITY=ssl
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# QUOKKA_TITLE=Quokka
# QUOKKA_LANGUAGE=it
# QUOKKA_ENCRYPTION=Off         On brings back OpenPGP / S/MIME
# UPLOAD_MAX_SIZE=25M
# SORTER_FIRST_DAYS=30     at the first start, sort the emails of the last N days too
